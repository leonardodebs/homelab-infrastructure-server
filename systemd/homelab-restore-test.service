[Unit]
Description=Teste mensal de restauração do backup HomeLab
Documentation=https://github.com/leonardodebs/homelab-infrastructure-server
RequiresMountsFor=/srv/backup
After=homelab-backup.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/homelab-restic-restore-test
Nice=15
IOSchedulingClass=best-effort
IOSchedulingPriority=7
PrivateTmp=true
ProtectHome=read-only
ProtectSystem=full
ReadWritePaths=/srv/backup /var/cache/restic-homelab /run/lock
TimeoutStartSec=6h
